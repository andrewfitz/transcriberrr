{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transcriberrr sample-timed transcript result v1",
  "description": "Half-open intervals at 16,000 samples per second. The session clock is relative to session zero and may be negative. Every observation, local word, and activity frame is relative to its own track's exact presentation origin. Activity never establishes a word or speaker observation.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "clock": {
      "enum": [
        "presentation",
        "session"
      ]
    },
    "sample_rate": {
      "const": 16000
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/speaker"
      }
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    }
  },
  "required": [
    "version",
    "clock",
    "sample_rate",
    "tracks",
    "speakers",
    "words"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "clock": {
            "const": "presentation"
          }
        }
      },
      "then": {
        "properties": {
          "tracks": {
            "minItems": 1,
            "maxItems": 1
          },
          "words": {
            "items": {
              "properties": {
                "start_sample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "end_sample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "time": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "speaker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "start_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "end_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "level": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start_sample",
        "end_sample",
        "level"
      ],
      "additionalProperties": false
    },
    "local_word": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "utterance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "word",
            "cue"
          ]
        },
        "start_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "end_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "text",
        "precision",
        "start_sample",
        "end_sample"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "word_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "enum": [
            "recognized",
            "inferred"
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "end_sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "track_id",
        "evidence",
        "start_sample",
        "end_sample"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "required": [
              "basis"
            ],
            "properties": {
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "word": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "utterance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "word",
            "cue"
          ]
        },
        "start_sample": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "end_sample": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "id",
        "text",
        "precision",
        "start_sample",
        "end_sample"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stream_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "channel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/time"
        },
        "session_start": {
          "$ref": "#/$defs/time"
        },
        "stream_evidence": {},
        "coverage": {
          "enum": [
            "recognized",
            "skipped",
            "failed",
            "coverage_only"
          ]
        },
        "role": {
          "enum": [
            "isolated_mic",
            "mixed_audio",
            "unknown"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "warning": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "activity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/local_word"
          }
        },
        "speakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speaker"
          }
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "session_start",
        "coverage",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
